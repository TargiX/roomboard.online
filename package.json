{
  "name": "flux-graph-pixi",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3050",
    "build": "next build",
    "start": "next start",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "readiness": "node scripts/readiness.mjs",
    "readiness:local": "READINESS_BASE_URL=http://localhost:3050 node scripts/readiness.mjs",
    "readiness:prod": "READINESS_BASE_URL=https://www.roomboard.online node scripts/readiness.mjs --strict",
    "realtime:prod": "node scripts/production-realtime-health.mjs",
    "realtime:prod:session": "node scripts/production-realtime-session-smoke.mjs",
    "release:local": "pnpm verify && pnpm readiness:local && git diff --check",
    "release:prod:check": "READINESS_EXPECTED_GIT_SHA=$(git rev-parse HEAD) pnpm readiness:prod && pnpm realtime:prod && SMOKE_BASE_URL=https://www.roomboard.online pnpm smoke",
    "smoke": "node scripts/smoke.mjs",
    "smoke:realtime": "node scripts/realtime-smoke.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/supabase-js": "^2.106.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lenis": "^1.3.25",
    "lucide-react": "^1.16.0",
    "motion": "^12.42.2",
    "next": "^16.2.6",
    "phoenix": "^1.8.7",
    "pixi.js": "^8.6.0",
    "posthog-js": "^1.418.10",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "stripe": "^22.2.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/phoenix": "^1.6.7",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "playwright": "^1.57.0",
    "prettier": "^3.9.7",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "unrs-resolver"
    ]
  }
}
